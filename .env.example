# ============================================================================
# CODEKANG PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# Database Configuration
# ============================================================================

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codekang_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codekang_platform
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3011/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3011/auth/github/callback

# GitHub App (for Autonomous AI webhooks)
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# ============================================================================
# MICROSERVICE CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=development

# Gateway Service
GATEWAY_PORT=3000
GATEWAY_URL=http://localhost:3000

# Auth Service
AUTH_HTTP_PORT=3011
AUTH_TCP_PORT=3001
AUTH_SERVICE_HOST=localhost

# AI Agent Service
AI_AGENT_TCP_PORT=3002
AI_AGENT_SERVICE_HOST=localhost

# Repos Service
REPOS_TCP_PORT=3003
REPOS_SERVICE_HOST=localhost

# Autonomous AI Agent
AUTONOMOUS_PORT=4000
AUTONOMOUS_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:4000/webhook

# Frontend
FRONTEND_PORT=3010
FRONTEND_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_AUTH_URL=http://localhost:3011

# ============================================================================
# FIREBASE (Admin SDK — for auth service)
# ============================================================================
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file; keep the \n escape sequences
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ============================================================================
# FIREBASE (Client SDK — frontend NEXT_PUBLIC_ vars)
# ============================================================================
# Get from Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ============================================================================
# ANTHROPIC API
# ============================================================================

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================================
# EMAIL (Transactional)
# ============================================================================

# Resend (primary — get API key from resend.com)
RESEND_API_KEY=re_...

# Zoho Mail SMTP (fallback — used when Resend fails or key is not set)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@yourdomain.com
ZOHO_SMTP_PASS=your-zoho-app-password

# Sender address shown in all outgoing emails
MAIL_FROM=CodeKang <noreply@codekang.dev>

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# PgAdmin
PGADMIN_EMAIL=admin@codekang.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis Commander
REDIS_ADMIN_USER=admin
REDIS_ADMIN_PASSWORD=admin
REDIS_COMMANDER_PORT=8081

# Bull Board
BULL_BOARD_PORT=3001

# Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3002
