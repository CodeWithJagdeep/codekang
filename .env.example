# ============================================================================
# CODEKANG PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values.
#
# PRODUCTION (VM — docker compose):
#   Set NODE_ENV=production and use the "production" values noted below.
#
# STAGING / LOCAL:
#   Set NODE_ENV=development and use localhost values.
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codekang_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codekang_platform
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ============================================================================
# ENVIRONMENT
# ============================================================================

# development | production
NODE_ENV=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# OAuth - Google
# production callback: https://api.codekang.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3011/auth/google/callback

# OAuth - GitHub
# production callback: https://api.codekang.com/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3010/auth/github/callback

# GitHub App (for Autonomous AI webhooks)
# production webhook URL: https://api.codekang.com/webhook
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# GitHub App slug — used to build the install URL and the post-install callback.
# In GitHub App settings → "Setup URL" must be set to: {FRONTEND_URL}/auth/callback/github-app
NEXT_PUBLIC_GITHUB_APP_NAME=codekang

# ============================================================================
# MICROSERVICE PORTS & HOSTS
# ============================================================================

# Gateway
GATEWAY_PORT=3000
# production: https://api.codekang.com  |  dev: http://localhost:3000
GATEWAY_URL=http://localhost:3000

# Auth Service
AUTH_HTTP_PORT=3011
AUTH_TCP_PORT=3001
AUTH_SERVICE_HOST=localhost

# AI Agent Service
AI_AGENT_TCP_PORT=3002
AI_AGENT_SERVICE_HOST=localhost

# Repos Service
REPOS_TCP_PORT=3003
REPOS_SERVICE_HOST=localhost

# Autonomous AI Agent
AUTONOMOUS_PORT=4000
# production: https://api.codekang.com  |  dev: http://localhost:4000
AUTONOMOUS_URL=http://localhost:4000
# production: https://api.codekang.com/webhook  |  dev: http://localhost:4000/webhook
WEBHOOK_URL=http://localhost:4000/webhook

# ============================================================================
# FRONTEND / CORS
# ============================================================================

FRONTEND_PORT=3010

# Comma-separated list of origins allowed by CORS.
# production: https://codekang.com,https://staging.codekang.com
# dev: http://localhost:3010  (all localhost:* ports are also auto-allowed in dev)
FRONTEND_URL=http://localhost:3010

# These are Vercel / frontend env vars — set them in Vercel project settings.
# production: https://api.codekang.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# production: https://api.codekang.com
NEXT_PUBLIC_AUTH_URL=http://localhost:3011
# production: https://api.codekang.com
NEXT_PUBLIC_WS_URL=http://localhost:3000
# production: https://api.codekang.com
NEXT_PUBLIC_AUTONOMOUS_URL=http://localhost:4000
# production | staging (staging disables search engine indexing)
NEXT_PUBLIC_APP_ENV=development

# ============================================================================
# INTERNAL SERVICE BRIDGE
# ============================================================================
# INTERNAL_SECRET — shared between gateway and autonomous-ai for internal calls.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=generate-a-random-64-char-hex-string-here

# URL autonomous-ai uses to reach the gateway inside Docker network.
# production (Docker): http://gateway:3000
# dev: http://localhost:3000
GATEWAY_INTERNAL_URL=http://localhost:3000

# ============================================================================
# FIREBASE (Admin SDK — auth service)
# ============================================================================
# Firebase Console → Project Settings → Service Accounts → Generate new private key

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file; keep the \n escape sequences
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ============================================================================
# FIREBASE (Client SDK — frontend NEXT_PUBLIC_ vars)
# ============================================================================
# Firebase Console → Project Settings → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ============================================================================
# ANTHROPIC API
# ============================================================================

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================================
# RAZORPAY
# ============================================================================
# Razorpay Dashboard → Settings → API Keys

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_STARTER_MONTHLY_ID=plan_...
RAZORPAY_PLAN_STARTER_ANNUAL_ID=plan_...
RAZORPAY_PLAN_TEAM_MONTHLY_ID=plan_...
RAZORPAY_PLAN_TEAM_ANNUAL_ID=plan_...

# ============================================================================
# EMAIL (Transactional)
# ============================================================================

# Resend (primary — resend.com)
RESEND_API_KEY=re_...

# Zoho Mail SMTP (fallback — used when Resend fails or key is not set)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@yourdomain.com
ZOHO_SMTP_PASS=your-zoho-app-password

MAIL_FROM=CodeKang <noreply@codekang.com>

# ============================================================================
# INTEGRATIONS — OAUTH APPS
# ============================================================================
# For each integration, register a redirect URI in the provider's developer console.
# production redirect base: https://api.codekang.com/api/v1/integrations
# dev redirect base:        http://localhost:3000/api/v1/integrations

# Discord (discord.com/developers/applications)
#   → OAuth2 → Redirects → add: {base}/discord/callback
#   → OAuth2 → Scopes: webhook.incoming
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Slack (api.slack.com/apps)
#   → OAuth & Permissions → Redirect URLs → add: {base}/slack/callback
#   → Bot Token Scopes: incoming-webhook
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# Linear (linear.app/settings/api/applications)
#   → Callback URL: {base}/linear/callback
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# Notion (notion.so/my-integrations — choose Public type)
#   → Redirect URIs: {base}/notion/callback
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

# Jira / Atlassian (developer.atlassian.com → OAuth 2.0 3LO)
#   → Callback URL: {base}/jira/callback
#   → Scopes: read:jira-work, write:jira-work, offline_access
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# GitLab (gitlab.com/-/user_settings/applications)
#   → Redirect URI: {base}/gitlab/callback
#   → Scopes: api, read_repository, write_repository
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret

# Bitbucket (bitbucket.org/account/settings/app-passwords → OAuth consumers)
#   → Callback URL: {base}/bitbucket/callback
BITBUCKET_CLIENT_ID=your-bitbucket-client-id
BITBUCKET_CLIENT_SECRET=your-bitbucket-client-secret

# ============================================================================
# OBSERVABILITY
# ============================================================================

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================================================
# DEVELOPMENT TOOLS (docker compose --profile tools)
# ============================================================================

PGADMIN_EMAIL=admin@codekang.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_ADMIN_USER=admin
REDIS_ADMIN_PASSWORD=admin
REDIS_COMMANDER_PORT=8081

BULL_BOARD_PORT=3099

PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3002
